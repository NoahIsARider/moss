{
  "name": "moss",
  "version": "2.0.0",
  "private": true,
  "description": "A small, self-hostable community suite: one shell, a shelf of plugins, your own domain.",
  "license": "ISC",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "bridge": "node server/chat-bridge.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "dev:demo": "node scripts/build-demo.mjs --prepare && next dev demo --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"lib/**/*.ts\" \"components/**/*.{ts,tsx}\" \"demo/**/*.{ts,tsx,mjs,json}\" \"scripts/*.mjs\" \"tests/**/*.{ts,mjs}\" \"playwright.config.ts\"",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8",
    "prettier": "^3.10.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.33"
  }
}
