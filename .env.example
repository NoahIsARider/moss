# Public identity
MOSS_TITLE=moss
MOSS_TAGLINE=one shell · any plugins · your own patch
MOSS_DESCRIPTION=A small, self-hostable community suite for labs and independent circles.
MOSS_DOMAIN=moss.example
MOSS_BASE_URL=https://moss.example
MOSS_ESTABLISHED=2026
MOSS_NEWS=This instance is live. Plugins can come and go; the shell stays the same.

# Example content for local previews only. Leave at 0 on a real instance.
MOSS_DEMO=0

# Where the code hub and this repo live. Replace with your own hosts.
MOSS_CODE_URL=https://code.moss.example
MOSS_REPOSITORY_URL=https://code.moss.example/moss/shell
MOSS_SECURITY_EMAIL=security@moss.example

# Which plugins are switched on. Comma separated, order is the sidebar order.
MOSS_PLUGINS=timeline,forge,chat,commons

# Session signing key. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MOSS_SECRET=change-me-before-you-expose-this

# Optional Forgejo/Gitea bridge. Leave empty to show an empty repository list.
FORGEJO_BASE_URL=
FORGEJO_TOKEN=
FORGEJO_OWNER=

# Optional Matrix bridge. Without it the chat plugin runs on its own WebSocket.
MATRIX_HOMESERVER_URL=
MATRIX_ACCESS_TOKEN=
MATRIX_ROOM_ID=

# Ports
CHAT_BRIDGE_PORT=8787
